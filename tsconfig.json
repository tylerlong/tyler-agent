{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"jsx": "react-jsx",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["node", "vite/client"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"test/**/*.ts",
		"vite.config.ts",
		"playwright.config.ts"
	]
}
