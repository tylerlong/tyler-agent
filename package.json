{
	"name": "tyler-agent",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "node --env-file-if-exists=.env src/server.ts --debug",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"typecheck": "tsc --noEmit",
		"test": "node --test test/*.test.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "^24.0.0",
		"typescript": "^5.9.0"
	},
	"packageManager": "pnpm@11.22.0"
}
