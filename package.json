{
	"name": "tyler-agent",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "pnpm build && node --watch src/server.ts",
		"build": "vite build",
		"format": "biome check . --write --vcs-enabled=true --vcs-client-kind=git --vcs-use-ignore-file=true",
		"format:check": "biome check . --vcs-enabled=true --vcs-client-kind=git --vcs-use-ignore-file=true",
		"typecheck": "tsc --noEmit",
		"test": "pnpm build && node --test test/*.test.ts",
		"test:e2e": "pnpm build && playwright test && node -e \"require('node:fs').rmSync('test-results', { recursive: true, force: true })\""
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.0",
		"vite": "^8.3.1"
	},
	"packageManager": "pnpm@11.22.0",
	"dependencies": {
		"i18next": "^26.4.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-i18next": "^17.0.15"
	}
}
